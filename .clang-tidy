Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  readability-braces-around-statements
WarningsAsErrors: ''
HeaderFilterRegex: '(^|/)(include/tower|tests)/'
SystemHeaders: false
